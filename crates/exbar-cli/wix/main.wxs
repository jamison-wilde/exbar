<?xml version='1.0' encoding='utf-8'?>
<!--
  Exbar MSI installer.
  Build with: wix build -arch x64 -d Version=0.1.0 -d CargoTargetBinDir=target/release \
               crates/exbar-cli/wix/main.wxs -o target/wix/exbar-0.1.0-x64.msi \
               -ext WixToolset.Util.wixext
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

    <Package
        Name="Exbar"
        Version="$(Version)"
        Manufacturer="Exbar"
        UpgradeCode="E47632D3-B73C-4EE3-B987-D2E04332BCDB"
        Language="1033"
        Compressed="yes"
        Scope="perUser"
        InstallerVersion="500">

        <SummaryInformation Description="Exbar — floating folder-shortcut toolbar for Windows 11 File Explorer" />

        <!-- AllowSameVersionUpgrades is REQUIRED, not cosmetic. WiX
             auto-generates a fresh ProductCode on every build, and the
             default MajorUpgrade only detects related products with a
             STRICTLY LOWER version. Reinstalling the same version (the
             normal dev/rebuild loop) therefore matched nothing, skipped
             RemoveExistingProducts, and installed side-by-side — one
             extra "Exbar" row in Settings → Apps per build. With this
             flag the current version is inside the detected range, so
             every reinstall replaces its predecessors. -->
        <MajorUpgrade
            AllowSameVersionUpgrades="yes"
            Schedule="afterInstallInitialize"
            DowngradeErrorMessage="A newer version of [ProductName] is already installed. Setup will now exit." />

        <MediaTemplate EmbedCab="yes" />

        <!-- Force file replacement on every install, even when version
             numbers match. Without this, Windows Installer's default
             version-comparison logic sees exbar.exe at the same 0.x.y
             version and skips the file copy, leaving an old binary in
             place across rebuilds. 'amus' = ignore Age/Date/Size, Must
             reinstall, Update side-by-side files, Shortcuts refreshed. -->
        <Property Id="REINSTALLMODE" Value="amus" />

        <!-- Shut down any running exbar.exe before replacing files -->
        <util:CloseApplication Id="CloseExbar"
                               Target="exbar.exe"
                               CloseMessage="yes"
                               TerminateProcess="500"
                               RebootPrompt="no" />

        <Feature Id="Main" Title="Exbar" Level="1">
            <ComponentRef Id="ExbarExe" />
            <ComponentRef Id="RunKey" />
            <ComponentRef Id="StartMenuShortcut" />
        </Feature>

        <!-- Uninstall metadata — shown in Settings → Apps.
             Windows Installer writes the ARP row itself, under
             HKCU\...\Uninstall\{ProductCode}, sourcing DisplayName from
             Package/@Name, DisplayVersion from @Version and Publisher
             from @Manufacturer. A hand-rolled Uninstall\Exbar registry
             component used to duplicate that row and, because its key
             name was fixed rather than ProductCode-keyed, survived as an
             orphan pointing at an uninstalled ProductCode. These three
             properties supply the only fields the automatic row misses.
             ARPNOMODIFY is not set here — WixUI_Minimal already declares it. -->
        <Property Id="ARPNOREPAIR" Value="1" />
        <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLDIR]" After="CostFinalize" />

        <!-- UI: WixUI_Minimal = Welcome/License → Finish. Finish dialog has
             a "Launch Exbar now" checkbox wired to WixShellExec. ShellExecute
             does NOT inherit msiexec's STARTUPINFO / console pipe, so Windows
             Terminal doesn't claim a phantom tab the way an ExeCommand-type
             deferred CustomAction would. -->
        <ui:WixUI Id="WixUI_Minimal" />
        <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Exbar now" />
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

        <!-- ShellExecute target — [#FileId] resolves to installed exe path.
             WixShellExec passes no arguments, so the CLI treats no-args as
             the `hook` subcommand (see main.rs). -->
        <Property Id="WixShellExecTarget" Value="[#ExbarExeFile]" />

        <CustomAction Id="LaunchApplication"
                      BinaryRef="Wix4UtilCA_X64"
                      DllEntry="WixShellExec"
                      Impersonate="yes"
                      Execute="immediate"
                      Return="check" />

        <UI>
            <Publish Dialog="ExitDialog"
                     Control="Finish"
                     Event="DoAction"
                     Value="LaunchApplication"
                     Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
        </UI>

        <StandardDirectory Id="LocalAppDataFolder">
            <Directory Id="INSTALLDIR" Name="Exbar" />
        </StandardDirectory>

        <!-- Start Menu shortcut so users can re-launch the toolbar after killing it -->
        <StandardDirectory Id="ProgramMenuFolder" />

        <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="*" Bitness="always64">
            <Shortcut Id="ExbarShortcut"
                      Name="Exbar"
                      Description="Floating folder-shortcut toolbar for File Explorer"
                      Target="[INSTALLDIR]exbar.exe"
                      Arguments="hook"
                      WorkingDirectory="INSTALLDIR" />
            <RegistryValue
                Root="HKCU"
                Key="Software\Exbar"
                Name="ShortcutInstalled"
                Type="integer"
                Value="1"
                KeyPath="yes" />
        </Component>

        <!-- exbar.exe component -->
        <Component Id="ExbarExe" Directory="INSTALLDIR" Guid="*" Bitness="always64">
            <File Id="ExbarExeFile"
                  Source="$(CargoTargetBinDir)\exbar.exe"
                  KeyPath="yes" />
        </Component>

        <!-- Run key: auto-start hook at login -->
        <Component Id="RunKey" Directory="INSTALLDIR" Guid="*" Bitness="always64">
            <RegistryValue
                Root="HKCU"
                Key="Software\Microsoft\Windows\CurrentVersion\Run"
                Name="Exbar"
                Type="string"
                Value="&quot;[INSTALLDIR]exbar.exe&quot; hook"
                KeyPath="yes" />

            <!-- Sweep up the pre-1.3.1 hand-rolled ARP key. Machines that
                 installed an older build carry a fixed-name Uninstall\Exbar
                 key whose owning ProductCode may already be gone, so
                 RemoveExistingProducts cannot reclaim it — it would linger
                 as a dead Settings → Apps row with a broken uninstall. -->
            <RemoveRegistryKey
                Root="HKCU"
                Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Exbar"
                Action="removeOnInstall" />
        </Component>

    </Package>
</Wix>
